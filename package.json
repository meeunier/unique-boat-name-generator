{
  "name": "unique-boat-name-generator",
  "version": "0.2.0",
  "description": "Funny boat names and fictional mariner usernames. Offline, seedable, no runtime dependencies.",
  "keywords": [
    "name-generator",
    "pseudonym",
    "username",
    "boat-names",
    "nautical",
    "puns",
    "react-native",
    "typescript"
  ],
  "license": "MIT",
  "author": "Antoine Meunier (https://meunier.co)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "data": "python3 -I research/scripts/05_build_runtime_data.py research/editorial/curated.json src/data/phrases.ts && python3 -I research/scripts/06_build_usernames.py",
    "sample": "node scripts/sample.mjs",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "demo": "npm run build:demo && node scripts/demo.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meeunier/unique-boat-name-generator.git"
  },
  "homepage": "https://github.com/meeunier/unique-boat-name-generator#readme",
  "bugs": {
    "url": "https://github.com/meeunier/unique-boat-name-generator/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
